# Copiaza ca deploy/.env si completeaza. NU comita fisierul .env (e ignorat de git).
NEXT_PUBLIC_SITE_URL=https://villalesmouettes.com

# Admin (/admin). Genereaza: openssl rand -base64 36
VLM_ADMIN_PASSWORD=
VLM_SECRET=
VLM_CRON_SECRET=
VLM_ICAL_KEY=

# Email (Resend). Domeniul trebuie verificat in Resend (SPF/DKIM).
RESEND_API_KEY=
VLM_MAIL_FROM=Villa Les Mouettes <booking@villalesmouettes.com>
VLM_OWNER_EMAIL=

# Plata (Stripe). Fara tarif sau chei, plata ramane dezactivata.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VLM_RATE_EUR_PER_NIGHT=

# Cand calendarul e gata si datele sunt reale: 1 (opreste modelul DEMO)
VLM_CALENDAR_LIVE=
# green | blue | petrol
NEXT_PUBLIC_VLM_ACCENT=green
