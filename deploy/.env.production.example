# Copiaza ca deploy/.env si completeaza. NU comita fisierul .env (e ignorat de git).
NEXT_PUBLIC_SITE_URL=https://villalesmouettes.com

# Admin (/admin). Genereaza: openssl rand -base64 36
VLM_ADMIN_PASSWORD=
VLM_SECRET=
VLM_CRON_SECRET=
VLM_ICAL_KEY=

# Email (Resend). Domeniul trebuie verificat in Resend (SPF/DKIM).
RESEND_API_KEY=
VLM_MAIL_FROM=Villa Les Mouettes <booking@villalesmouettes.com>
VLM_OWNER_EMAIL=

# Plata (Stripe). Fara chei, plata ramane dezactivata. Tarifele sunt in src/lib/pricing.ts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Calendar: gol = curat (doar datele reale). 1 = afiseaza un model DEMO de date ocupate (doar pentru teste)
VLM_CALENDAR_DEMO=
# green | blue | petrol
NEXT_PUBLIC_VLM_ACCENT=green
